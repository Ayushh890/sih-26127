# NIRNAY configuration. Copy to .env and edit. Never commit .env.
# Every variable is optional in development: the defaults give a zero-config demo
# (SQLite + in-process event bus + seeded synthetic demo cameras).

# --- general -------------------------------------------------------------------
# development | production | test
APP_ENV=development
LOG_LEVEL=INFO
# structured JSON logs (one object per line)
LOG_JSON=true

# --- storage -------------------------------------------------------------------
# SQLite (default): sqlite:////absolute/path/nirnay.db  (default $DATA_DIR/nirnay.db)
# PostgreSQL:    postgresql+psycopg://nirnay:<password>@postgres:5432/nirnay
#                (postgres:// and postgresql:// URLs from hosting providers are accepted as-is)
# DATABASE_URL=
# e.g. redis://redis:6379/0 ; empty = in-process bus (single process only)
# REDIS_URL=
# default: <repo>/data and <repo>/models (absolute paths recommended when overriding)
# DATA_DIR=/var/lib/nirnay
# MODELS_DIR=/opt/nirnay/models
# built console (frontend/dist): when set, the API also serves the console on the same origin
# (single-container image docker/app.Dockerfile). Leave unset with Compose (nginx serves it).
# FRONTEND_DIR=/app/frontend/dist

# --- processes -------------------------------------------------------------------
# embedded | external (needs REDIS_URL) | api-only
WORKER_MODE=embedded
WORKER_ID=worker-1
# index/count: with several `--role streams` workers give each a distinct index (0/2, 1/2, …);
# cameras are split between them by a stable hash of the camera id
WORKER_SHARD=0/1

# --- security (REQUIRED in production) ---------------------------------------------
# JWT_SECRET: at least 32 random characters, e.g.  python -c "import secrets;print(secrets.token_urlsafe(48))"
# JWT_SECRET=
# ENCRYPTION_KEY: Fernet key, e.g.  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=
# PSEUDONYM_SECRET: HMAC key for plate pseudonyms shown to analytics roles
# PSEUDONYM_SECRET=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_MINUTE=10
PRIVACY_MODE=true
# Fernet-encrypt evidence images at rest
EVIDENCE_ENCRYPTION=false

# --- accounts ------------------------------------------------------------------------
# Demo accounts admin/operator/analyst/viewer (development only; must be false in production)
DEMO_USERS=true
DEMO_PASSWORD=nirnay-demo
# Bootstrap administrator created on first start (production)
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# --- demo ------------------------------------------------------------------------------
# seed the synthetic demo network (cameras are labelled DEMO)
SEED_DEMO=true
DEMO_AUTOSTART=true
# 0 = derive from the CPU budget
DEMO_PROCESSING_FPS=0
# synthetic = frames rendered live by the demo scene; recorded = pre-rendered MP4 files played
# through the file source (generate with: python backend/scripts/generate_demo_videos.py)
DEMO_SOURCE=synthetic
# comma-separated demo cameras started automatically (empty = all six). The rest are seeded
# but stopped; each running camera needs ~130 MB RAM, so e.g. CAM-01,CAM-02,CAM-03 on 1 GB hosts
# DEMO_CAMERAS=

# --- pipeline defaults (per-camera values override these) ------------------------------
# auto | cpu | gpu
INFERENCE_DEVICE=auto
INFERENCE_THREADS=0
DEFAULT_PROCESSING_FPS=5
DEFAULT_CONFIDENCE_THRESHOLD=0.35
OCR_CONFIDENCE_THRESHOLD=0.55
CAMERA_TIMEOUT=8
CAMERA_MAX_BACKOFF=60

# --- retention (defaults; operators can change them in Settings) -------------------------
RETENTION_OBSERVATION_DAYS=30
RETENTION_EVIDENCE_DAYS=14
RETENTION_HEALTH_DAYS=7

# --- docker compose only -------------------------------------------------------------------
# POSTGRES_PASSWORD=

# --- memory (set in the Dockerfiles) ---------------------------------------------------------
# limits glibc malloc arenas; without it the many pipeline threads inflate RSS by hundreds of MB
# MALLOC_ARENA_MAX=2
